{
  "quote": {
    "title": "Inspection quote",
    "currency": "UGX",
    "inputs": [
      {
        "id": "quantity",
        "label": "Quantity",
        "kind": "stepper",
        "default": 4,
        "min": 1,
        "max": 10000,
        "step": 1
      },
      {
        "id": "price",
        "label": "Unit price",
        "kind": "number",
        "default": 80000,
        "min": 0,
        "max": 10000000,
        "step": 1,
        "display": "money"
      },
      {
        "id": "discount",
        "label": "Discount (%)",
        "kind": "range",
        "default": 1000,
        "min": 0,
        "max": 10000,
        "step": 1,
        "display": "basisPoints"
      }
    ],
    "graph": [
      {
        "id": "subtotal",
        "op": "mul",
        "args": [
          {
            "ref": "quantity"
          },
          {
            "ref": "price"
          }
        ]
      },
      {
        "id": "discountProduct",
        "op": "mul",
        "args": [
          {
            "ref": "subtotal"
          },
          {
            "ref": "discount"
          }
        ]
      },
      {
        "id": "discountRaw",
        "op": "div",
        "args": [
          {
            "ref": "discountProduct"
          },
          10000
        ]
      },
      {
        "id": "saving",
        "op": "round",
        "args": [
          {
            "ref": "discountRaw"
          }
        ]
      },
      {
        "id": "total",
        "op": "sub",
        "args": [
          {
            "ref": "subtotal"
          },
          {
            "ref": "saving"
          }
        ]
      }
    ],
    "outputs": [
      {
        "kind": "metrics",
        "items": [
          {
            "label": "Total",
            "value": {
              "ref": "total"
            },
            "format": "money"
          },
          {
            "label": "Discount",
            "value": {
              "ref": "saving"
            },
            "format": "money"
          }
        ]
      },
      {
        "kind": "table",
        "columns": [
          {
            "label": "Item"
          },
          {
            "label": "Amount",
            "format": "money"
          }
        ],
        "rows": [
          [
            "Subtotal",
            {
              "ref": "subtotal"
            }
          ],
          [
            "Total",
            {
              "ref": "total"
            }
          ]
        ]
      }
    ],
    "actions": [],
